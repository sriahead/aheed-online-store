// Walking-skeleton schema: ONE model, just enough to prove the end-to-end DB path.
// Real relational model (Users, Products, Orders, …) arrives in P1+ per specs/architecture.md.

generator client {
  provider   = "prisma-client-js"
  // Prisma 6+: driver adapters are GA (no preview flag needed).
  // Prisma 5:  previewFeatures = ["driverAdapters"]
  // engineType = "client" (WASM query compiler, imported directly rather than
  // discovered via fs) is required on Cloudflare Workers — the default
  // "library" engine calls fs.readdir at runtime to locate its native engine
  // binary, which workerd's nodejs_compat polyfill doesn't implement.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (runtime)
  directUrl = env("DIRECT_URL") // direct (migrations)
}

model HealthCheck {
  id        String   @id @default(uuid())
  label     String   @default("ok")
  checkedAt DateTime @default(now())

  @@index([checkedAt])
}

// Better Auth's standard relational schema (ADR-002) — model/field names match its own
// conventions so the Prisma adapter needs no custom mapping config. `role` is our own
// RBAC addition (Customer/Staff/Admin, mission.md); Better Auth passes unknown-to-it
// fields through untouched. No @default(uuid()) on these ids — Better Auth's adapter
// generates and supplies them itself on create.
// Platform-level role (ADR-004 slice 3a). Platform ADMIN is the operator and transcends
// all vendors; most users are CUSTOMER. Per-vendor staff/admin is VendorMembership, not this.
enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

// Per-vendor role (ADR-004 slice 3a). A VendorMembership grants staff/admin at ONE vendor;
// there is no CUSTOMER here (a membership IS a staff/admin grant).
enum VendorRole {
  STAFF
  ADMIN
}

model User {
  id                  String               @id
  name                String
  email               String               @unique
  emailVerified       Boolean              @default(false)
  image               String?
  role                Role                 @default(CUSTOMER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  accounts            Account[]
  reviews             Review[]
  memberships         VendorMembership[]
  carts               Cart[]
  addresses           Address[]
  orders              Order[]
  statusChanges       OrderStatusEvent[]   @relation("OrderStatusEventActor")
  loyaltyAccounts     LoyaltyAccount[]
  loyaltyEntries      LoyaltyLedgerEntry[]
  discountUses        DiscountRedemption[]
  roleChangesTargeted VendorRoleAuditLog[] @relation("TargetUser")
  roleChangesActedOn  VendorRoleAuditLog[] @relation("ActorUser")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

// ADR-004 slice 1 — multi-tenancy (specs/2026-08-08-multitenancy-slice1-vendor-schema/).
// Vendor is the tenancy root; every domain row carries a required vendorId. Read-side
// vendorId filtering is enforced centrally in slice 2 (lib/repositories/*). All existing
// data is backfilled to a single "Aheed Food Centre" vendor.
enum VendorStatus {
  ACTIVE
  SUSPENDED
}

model Vendor {
  id                     String                  @id @default(uuid())
  slug                   String                  @unique
  name                   String
  status                 VendorStatus            @default(ACTIVE)
  customDomain           String?                 @unique // used in slice 3 (host→tenant resolution)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  branding               VendorBranding?
  config                 VendorConfig?
  deliveryAreas          VendorDeliveryArea[]
  categories             Category[]
  products               Product[]
  inventory              Inventory[]
  reviews                Review[]
  memberships            VendorMembership[]
  domains                VendorDomain[]
  carts                  Cart[]
  cartItems              CartItem[]
  addresses              Address[]
  orders                 Order[]
  orderItems             OrderItem[]
  payments               Payment[]
  orderEvents            OrderStatusEvent[]
  loyaltyTiers           VendorLoyaltyTier[]
  loyaltyAccounts        LoyaltyAccount[]
  loyaltyEntries         LoyaltyLedgerEntry[]
  discountCodes          DiscountCode[]
  discountUses           DiscountRedemption[]
  roleAuditLogs          VendorRoleAuditLog[]
  lookupAttempts         OrderLookupAttempt[]
  campaigns              DepartmentCampaign[]
  bundles                Bundle[]
  priceTiers             ProductPriceTier[]
  authenticationAttempts AuthenticationAttempt[]
  bindingRefusals        PaymentBindingRefusal[]
  searchQueryLogs        SearchQueryLog[]
}

// Host→tenant resolution (ADR-004 slice 3b). One row per hostname a vendor answers on
// (exact match); staging and prod are separate DBs, so each holds its own env's hosts.
// Supersedes the unused Vendor.customDomain (kept for now; dropped in a later cleanup).
model VendorDomain {
  id          String   @id @default(uuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  host        String   @unique // exact request host, e.g. "srimart.nocaped.com"
  isCanonical Boolean  @default(true) // the vendor's primary host (for links / future redirects)
  createdAt   DateTime @default(now())

  @@index([vendorId])
}

// Per-vendor staff/admin grant (ADR-004 slice 3a). Identity stays global (User); this
// scopes authorization to a single vendor. One row per (user, vendor).
model VendorMembership {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  role      VendorRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, vendorId])
  @@index([vendorId])
}

// Satellite config/branding tables ship EMPTY in slice 1 — their values (and the code that
// reads them) arrive in slice 4. Explicit columns only, never a Json column (CLAUDE.md).
model VendorBranding {
  id              String   @id @default(uuid())
  vendorId        String   @unique
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name            String
  tagline         String?
  logoStorageKey  String? // RELATIVE key only (ADR-003) — never a URL
  // Brand color PRIMITIVES (mirror design-system/tokens/tokens.css --color-brand-*),
  // injected per vendor as CSS custom properties in slice 4. Hex strings.
  brandGreenDark  String
  brandGreen      String
  brandOrange     String
  brandRed        String
  brandCream      String
  brandGreenTint  String
  brandOrangeTint String
  brandRedTint    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model VendorConfig {
  id                         String   @id @default(uuid())
  vendorId                   String   @unique
  vendor                     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  localityName               String // e.g. "Milton Keynes"
  senderName                 String // transactional email sender identity
  senderEmail                String
  searchPlaceholder          String? // header search-box copy, e.g. "Search halal lamb, basmati, lentils…"
  // P7.5c+f (#239) — per-vendor storefront copy. Both nullable, and a null HIDES
  // its element rather than falling back to neutral filler: platform-written
  // marketing is still a claim made on a vendor's behalf, and the copy these
  // replaced ("100% Certified HMC Halal Fresh Meat Cut Daily", "Same-Day Local
  // Dispatch") was rendering for every vendor, SriMart included.
  bannerNote                 String? // header's second banner line
  heroSubtitle               String? // hero's supporting paragraph, under the tagline
  // P3a — delivery rules are vendor data, never constants (the AI Studio mockup hardcoded a
  // £30 threshold). Prisma-level defaults mean a newly-inserted vendor is valid without the
  // seed supplying values. P3a reads only the threshold (cart banner); applying the fee and
  // the minimum to a payable total is P3b.
  deliveryFeePence           Int      @default(349)
  freeDeliveryThresholdPence Int? // null = free delivery never offered
  minimumOrderPence          Int      @default(0) // 0 = no minimum
  // P5a — loyalty settings are vendor data for the same reason the delivery rules
  // above are (#135). Defaults mean an existing VendorConfig row stays valid with
  // no backfill, and loyaltyEnabled defaults OFF so the feature ships dark for any
  // vendor that hasn't opted in.
  loyaltyEnabled             Boolean  @default(false)
  pointsPerPoundEarned       Int      @default(1) // points per whole £1 of eligible spend
  pencePerPointRedeemed      Int      @default(1) // 100 points = £1
  minRedeemPoints            Int      @default(100) // below this, redemption isn't offered
  tierWindowDays             Int      @default(30) // rolling window tier qualification looks back over
  pointsExpiryMonths         Int? // null = points never expire
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

// P5a — per-vendor loyalty tiers (#135). A shopper's tier is resolved from their
// qualifying spend over VendorConfig.tierWindowDays; the highest threshold at or
// below that spend wins. Multipliers are BASIS POINTS (10000 = 1.0x) — integer
// arithmetic end to end, for the same reason money is pence.
model VendorLoyaltyTier {
  id             String   @id @default(uuid())
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  key            String // stable identifier, e.g. "SILVER"
  name           String // display name
  thresholdPence Int // qualifying spend at or above which this tier applies
  multiplierBps  Int      @default(10000)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([vendorId, key])
  @@index([vendorId, thresholdPence])
}

model VendorDeliveryArea {
  id       String @id @default(uuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  prefix   String // postcode district prefix, e.g. "MK"

  @@unique([vendorId, prefix])
}

// P2a — catalogue browsing (specs/2026-08-07-p2a-catalogue-browsing/). Matches the
// representative schema already designed in specs/architecture.md §3.2.
model Category {
  id        String              @id @default(uuid())
  vendorId  String
  vendor    Vendor              @relation(fields: [vendorId], references: [id])
  slug      String
  name      String
  parentId  String?
  parent    Category?           @relation("Sub", fields: [parentId], references: [id])
  children  Category[]          @relation("Sub")
  sortOrder Int                 @default(0)
  isActive  Boolean             @default(true)
  products  Product[]
  campaign  DepartmentCampaign?

  @@unique([vendorId, slug])
  @@unique([id, vendorId])
  @@index([vendorId, parentId, isActive])
}

// P8.5e (#356) — staff-editable hero campaign content, one row per top-level
// Category. Reopens the "general campaign surface" ADR-004 (decision 5, 1.7.0)
// named as future work, this time with the staff UI that made the deleted
// VendorPromotion (P8.5b, #346) inert. `headline`/`subtitle` are free text —
// a deliberate, narrow exception to "promotional content is data" (ADR-004
// 1.8.0) — while `imageKey`/`linkUrl`/the schedule stay structured, and
// `DepartmentHero` always renders the real product-price callout alongside a
// campaign's copy regardless.
model DepartmentCampaign {
  id         String    @id @default(uuid())
  vendorId   String
  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId String    @unique
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  headline   String
  subtitle   String?
  imageKey   String? // RELATIVE key only (ADR-003) — never a URL
  altText    String? // required by jsx-a11y whenever imageKey is set
  linkUrl    String? // relative path only, e.g. "/categories/household?isOffer=true"
  isActive   Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Serves both queries this model has: "this vendor's active campaigns" (the
  // hero read) and "does this category already have a campaign" (categoryId
  // is unique, so a lookup by it alone is already indexed).
  @@index([vendorId, isActive])
}

// P8.5c (#347) — a curated BUNDLE is a vendor-authored list of products already
// in the catalogue, which "Add all N to basket" expands into ordinary CartItem
// rows. It is deliberately NOT a purchasable SKU: that shape would need its own
// inventory, its own decrement inside placeOrder's transaction, and its own
// cases in refunds, loyalty and discounts — four subsystems changed to sell
// three things the catalogue already holds.
//
// THERE IS NO STORED PRICE OR SAVING HERE, and that is the whole design.
// A bundle's total is summed from its constituents' live Product.basePrice at
// read time (lib/bundle-pricing.ts), so it can never drift out of date the way
// a copied price would. The accepted cost: the figure cannot be hand-set, so a
// genuine "save £4.50" needs a mechanism that actually reduces the charge —
// that is P8.5d (#348), auto-applied quantity-triggered tier pricing, and it is
// NOT built. Until it is, the storefront shows the derived total and makes no
// savings claim at all rather than render a number with nothing behind it.
model Bundle {
  id        String       @id @default(uuid())
  vendorId  String
  vendor    Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  tagline   String?
  imageKey  String? // RELATIVE key only (ADR-003) — never a URL
  altText   String? // required by jsx-a11y whenever imageKey is set
  isActive  Boolean      @default(true)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  items     BundleItem[]

  @@unique([vendorId, slug])
  @@index([vendorId, isActive])
}

// One constituent line of a bundle. `quantity` is how many of that product the
// bundle contributes, which is what makes "2 x 60g packs" expressible as data
// rather than as the prototype's free-text label.
//
// @@unique([bundleId, productId]) keeps a product from appearing twice in one
// bundle. sumLinesByProduct (lib/cart-rules.ts) would collapse duplicates
// safely at add time anyway, but two rows for one product would render as two
// visually identical constituent entries, which is a data defect, not a
// rendering one.
model BundleItem {
  id        String  @id @default(uuid())
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  sortOrder Int     @default(0)

  @@unique([bundleId, productId])
  @@index([bundleId, sortOrder])
}

model Product {
  id                   String            @id @default(uuid())
  vendorId             String
  vendor               Vendor            @relation(fields: [vendorId], references: [id])
  slug                 String
  name                 String
  description          String
  categoryId           String
  category             Category          @relation(fields: [categoryId, vendorId], references: [id, vendorId])
  basePrice            Int // pence
  unitLabel            String // "£2.40 / kg"
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  images               ProductImage[]
  inventory            Inventory?
  reviews              Review[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  bundleItems          BundleItem[]
  priceTier            ProductPriceTier?
  averageRating        Float             @default(0) // denormalized, recomputed on every review write
  reviewCount          Int               @default(0)
  // P2.5b1 — visual redesign foundation (specs/2026-08-07-p2-5b1-visual-foundation/).
  // originalPrice, when set, is basePrice's pre-discount price — a discount badge is
  // derived from the difference at render time, not a separate boolean flag that could
  // drift out of sync with the actual prices.
  origin               String?
  originalPrice        Int? // pence, pre-discount price
  isHalal              Boolean           @default(false)
  isFresh              Boolean           @default(false)
  isOrganic            Boolean           @default(false)
  // #211 — vendor curation flag driving the homepage "Featured Products" rail.
  // Independent of originalPrice's discount-badge derivation: featured and
  // "on offer" are two separate concepts.
  isFeatured           Boolean           @default(false)
  imageNeedsReview     Boolean           @default(false)
  // #523 — how many times the image pipeline has tried this product and failed.
  //
  // Workers AI permanently refuses some legitimate names: `Halal Chicken Thighs 1kg`
  // returned `AiError: Input prompt contains NSFW content` on every attempt. Without a
  // record of that, `getProductsWithoutImages` — newest-first and BOUNDED — re-selects
  // the same doomed product on every scheduled run, consumes one of the run's slots,
  // fails, and never reaches the products that could actually have been filled, while
  // the job still reports success. The counter is what lets the selection give up.
  //
  // Reset to 0 whenever an image is successfully saved, so a product that later loses
  // its image is retried rather than being permanently excluded by a historic failure.
  imageAttemptFailures Int               @default(0)

  @@unique([vendorId, slug])
  @@index([vendorId, categoryId, isActive])
  @@index([vendorId, isActive, basePrice]) // catalogue filter + sort
  @@index([vendorId, isActive, isFeatured]) // homepage featured rail
}

// ---- P8.5d — Multi-buy tier pricing (#348) ----------------------------------

/// A product's multi-buy tier: `groupQuantity` units for `groupPricePence`.
/// "3 for £10.00". Applied automatically with nothing typed.
///
/// THIS IS A PRICE, NOT A DISCOUNT, and deliberately so. A codeless
/// DiscountCode was rejected at /propose on three counts: DiscountRedemption
/// has @@unique([orderId]) so an order carries at most one redemption row;
/// evaluateCode (lib/discounts.ts) is subtotal-scoped and cannot express a
/// per-line quantity predicate; and #273 exists because redemption rows were
/// once written around placeOrder's transaction. Pricing a line differently
/// leaves the whole discounts engine — its audit trail and both its concurrency
/// guarantees — untouched. OrderItem already stores unitPricePence and
/// lineTotalPence separately, so the per-order audit record needed no change.
///
/// A GROUP price, not a reduced unit price, because "3 for the price of 2" has
/// no exact unit price: on a £5 item that is 1000/3 = 333p, charging £9.99
/// forever. Groups are exact integer pence at every quantity. The arithmetic
/// (whole groups at groupPricePence, remainder units at basePrice, clamped so a
/// mistyped tier can never charge MORE than base) lives in lib/tier-pricing.ts.
///
/// EXACTLY ONE TIER PER PRODUCT, via @@unique([vendorId, productId]). Two
/// concurrent multi-buys on one product ("3 for £10" and "5 for £15") would make
/// a line total an optimal-packing problem with more than one defensible answer;
/// one row makes the arithmetic unambiguous by construction. Editing a live tier
/// is safe because orders snapshot OrderItem.lineTotalPence and never recompute.
///
/// No startsAt/endsAt: date windowing would re-open the hardcoded vendor
/// timezone (#363), which P8.5f had just finished fixing a campaign date bug
/// over. isActive only until #363 is resolved.
model ProductPriceTier {
  id              String   @id @default(uuid())
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  /// @unique carries the one-tier-per-product rule on its own (a product belongs
  /// to exactly one vendor, so per-product and per-vendor-product mean the same
  /// thing here) and is what lets `Product.priceTier` be a true 1-1. The
  /// composite @@unique below is kept anyway: it is the index every vendor-scoped
  /// read actually goes through, since R12a requires vendorId in the where clause
  /// rather than trusting a bare productId lookup.
  productId       String   @unique
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Units per group. Always >= 2 — 1 would be a markdown, which is
  /// Product.originalPrice's job. lib/tier-pricing.ts refuses anything lower.
  groupQuantity   Int
  /// Pence charged for one whole group.
  groupPricePence Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([vendorId, productId])
  @@index([vendorId, isActive])
}

model ProductImage {
  id         String  @id @default(uuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  storageKey String // RELATIVE key only — never a URL
  alt        String
  sortOrder  Int     @default(0)
  isPrimary  Boolean @default(false)

  @@index([productId, sortOrder])
}

model Inventory {
  id                String   @id @default(uuid())
  vendorId          String
  vendor            Vendor   @relation(fields: [vendorId], references: [id])
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id])
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(3)
  updatedAt         DateTime @updatedAt

  @@index([vendorId])
}

// P2.5a — ratings & reviews (specs/2026-08-07-p2-5a-ratings-reviews/). One review
// per user per product; resubmitting updates the existing row. Product's
// averageRating/reviewCount are denormalized and recomputed on every write.
model Review {
  id        String   @id @default(uuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorId, userId, productId])
  @@index([vendorId, productId, createdAt])
}

// P3a — cart foundation (specs/2026-08-09-p3a-cart-foundation/, #93).
// One cart per (vendor, identity): shopping at two vendors gives two independent
// carts, which falls straight out of ADR-004 row-level tenancy.
// Identity is EXACTLY ONE of userId / guestToken — a guest cart is keyed by an
// opaque token in a host-only cookie, and is merged into the account cart only
// when the shopper explicitly chooses (never silently).
model Cart {
  id         String     @id @default(uuid())
  vendorId   String
  vendor     Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]

  @@unique([vendorId, userId])
  @@unique([vendorId, guestToken])
  @@index([vendorId])
}

// Deliberately stores NO price. Price is read from Product at render time and is
// snapshotted into OrderItem at order creation (P3b) — a cart that cached prices
// would silently serve stale money after a price change.
model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
}

// P3b — checkout + order core (specs/2026-08-10-p3b-checkout-order-core/, #96).
// PENDING_PAYMENT is the initial state: stock is decremented at order creation but
// payment is not yet settled, so an order must NOT read as CONFIRMED (staff would
// pick and deliver it). P3c's Stripe webhook moves it to CONFIRMED.
enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// Per-order delivery address SNAPSHOT. Written once and never updated — editing a
// saved address later must not rewrite where a past order was delivered
// (architecture.md §3.1: "historical snapshots are intentional"). userId is
// nullable so a future saved-address book can reuse this table with no migration.
model Address {
  id            String   @id @default(uuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  recipientName String
  phone         String
  line1         String
  line2         String?
  city          String
  postcode      String
  notes         String?
  createdAt     DateTime @default(now())
  orders        Order[]

  @@index([vendorId])
}

// Exactly one of userId / guestEmail identifies the buyer (enforced in the
// repository). Money is integer pence throughout; no discountTotal/loyaltyRedeemed
// columns — those are P5's to add when they exist.
//
// NOT FULLY DESCRIBED BY THIS SCHEMA (P7.5d+e, #163). Three GIN trigram indexes —
// Order_orderNumber_trgm_idx, Order_guestEmail_trgm_idx and User_email_trgm_idx —
// exist in the database but CANNOT be declared here: Prisma's schema language has
// no syntax for an index's access method or operator class, so `@@index` always
// means a B-tree, which cannot serve the staff order search's `ILIKE '%term%'`.
// They are created by migration 20260820143949_p7_5de_order_search_trigram, which
// carries the full rationale. Consequence: `prisma migrate diff` may report drift
// that is not drift, and `prisma migrate dev` may propose DROPPING them. Keep them.
model Order {
  id                String                  @id @default(uuid())
  vendorId          String
  vendor            Vendor                  @relation(fields: [vendorId], references: [id])
  orderNumber       String                  @unique
  // P9.1 (#427/#428) — a guest order's actual credential. The order number is
  // NOT one: it appears in emails, shared links, browser history and support
  // threads, so knowing it must not return a name and a residential address.
  // Nullable because every order placed before this migration has none; those
  // guests fall back to /orders/lookup (order number + email). Never selected
  // into OrderSummary — see findOrderForViewer.
  confirmationToken String?                 @unique
  userId            String?
  user              User?                   @relation(fields: [userId], references: [id])
  guestEmail        String?
  addressId         String
  address           Address                 @relation(fields: [addressId], references: [id])
  status            OrderStatus             @default(PENDING_PAYMENT)
  currency          String                  @default("GBP")
  subtotalPence     Int
  // P5a (#135) — a GENERIC discount column, not a points-specific one: P5b's
  // discount codes reduce the same total and must not need a second column and a
  // second arithmetic rule. The order money identity is
  // subtotalPence - discountPence + deliveryFeePence = totalPence.
  discountPence     Int                     @default(0)
  deliveryFeePence  Int
  totalPence        Int
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  items             OrderItem[]
  payment           Payment?
  statusEvents      OrderStatusEvent[]
  loyaltyEntries    LoyaltyLedgerEntry[]
  discountUse       DiscountRedemption?
  bindingRefusals   PaymentBindingRefusal[]

  @@index([vendorId, createdAt])
  @@index([vendorId, status, createdAt])
  // P7d (#218) — order history. listForUser filters {vendorId, userId} ordered by
  // (createdAt desc, id desc); without userId in an index Postgres can only walk the
  // VENDOR's orders in date order and discard other customers' rows, so a shopper's
  // history costs the store's whole order volume. specs/architecture.md §3.4 claimed an
  // Order(userId, createdAt) index served this — it never existed.
  @@index([vendorId, userId, createdAt])
}

// productName / unitPricePence are SNAPSHOTS at purchase time — a later price or
// rename must never rewrite what the customer actually bought.
model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor  @relation(fields: [vendorId], references: [id])
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  productName    String
  unitPricePence Int
  quantity       Int
  lineTotalPence Int

  @@index([orderId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            Vendor        @relation(fields: [vendorId], references: [id])
  status            PaymentStatus @default(PENDING)
  provider          String
  providerReference String?
  amountPence       Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
}

model OrderStatusEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor      @relation(fields: [vendorId], references: [id])
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  // Who moved it (P4b, #125). Null for system transitions — P3b's order
  // placement and P3c's payment webhook have no acting user, and nullable is
  // what lets this column be added with no backfill. SetNull, not Cascade:
  // removing a departed staff member's account must not delete the audit trail
  // of the orders they handled.
  createdByUserId String?
  createdBy       User?   @relation("OrderStatusEventActor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ---- P5a — loyalty points (#135, specs/2026-08-11-p5a-loyalty-points/) --------

enum LoyaltyEntryKind {
  EARN
  REDEEM
  REVERSAL
}

/// The append-only audit trail of every points movement. `points` is SIGNED:
/// EARN is positive, REDEEM negative, REVERSAL the exact negation of the REDEEM
/// it undoes. Nothing here is ever updated or deleted.
///
/// @@unique([orderId, kind]) is the structural idempotency guard: a duplicate
/// Stripe delivery attempting a second EARN, or a double-submitted checkout
/// attempting a second REDEEM, is refused by the database rather than by a check
/// someone has to remember to write.
model LoyaltyLedgerEntry {
  id       String           @id @default(uuid())
  vendorId String
  vendor   Vendor           @relation(fields: [vendorId], references: [id])
  // Nullable since P7b (#216). Erasure must sever the personal link WITHOUT
  // destroying the row: a surviving Order keeps its discountPence, and this
  // ledger is the only thing that explains where that number came from. The
  // column was non-null with onDelete: Cascade, so deleting a User took the
  // financial audit trail with it — against this model's own append-only rule.
  // A null userId means "the person who earned or spent these points has been
  // erased", never "no owner" — every write path still requires one.
  userId   String?
  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId  String
  order    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind     LoyaltyEntryKind
  points   Int // signed

  // Snapshotted on EARN only. Tier is resolved from a windowed spend query whose
  // answer changes over time, so an audit trail that cannot explain its own
  // numbers would not be one. Null on REDEEM/REVERSAL.
  tierKey       String?
  multiplierBps Int?

  createdAt DateTime @default(now())

  @@unique([orderId, kind])
  @@index([vendorId, userId, createdAt])
}

/// The concurrency anchor for a shopper's balance at one vendor.
///
/// NOT a redundant cache of the ledger: a balance derived by SUM() cannot be
/// compare-and-set, and every other contended resource in this schema is
/// protected that way. This is the same pairing the stock path already uses —
/// Inventory.quantity is the guarded counter, OrderItem is the record of what
/// moved.
///
/// `lastActivityAt` is what makes expiry derivable at read time instead of
/// needing a sweep job: points lapse when it falls further behind than
/// VendorConfig.pointsExpiryMonths. A lapsed row's balancePoints is stale until
/// its next EARN, which RESETS rather than increments (see lib/loyalty.ts).
model LoyaltyAccount {
  id             String   @id @default(uuid())
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balancePoints  Int      @default(0)
  lifetimePoints Int      @default(0)
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([vendorId, userId])
}

// ---- P5b — discount codes (#145, specs/2026-08-11-p5b-discount-codes/) --------

enum DiscountKind {
  PERCENTAGE
  FIXED_AMOUNT
}

/// A vendor's discount code. Codes are per-vendor data for the same reason the
/// loyalty settings and delivery rules above are — two vendors may run the same
/// code string on their own terms, which @@unique([vendorId, code]) permits and
/// a global unique would not.
///
/// `remainingRedemptions` COUNTS DOWN and is the concurrency anchor: null means
/// unlimited, and the claim guard is `remainingRedemptions: { gt: 0 }` with a
/// decrement. The natural shape — usedCount < maxRedemptions — is a
/// column-to-column comparison, which Prisma cannot express in a `where` and
/// which CLAUDE.md forbids solving with raw SQL. Counting down turns it into the
/// same literal-to-column guard Inventory.quantity (P3b) and
/// LoyaltyAccount.balancePoints (P5a) already use. Postgres arithmetic on NULL is
/// NULL, so an unlimited code decrements to unlimited with no special case.
///
/// There is deliberately NO usedCount column: a "times used" figure for the admin
/// list is derived from DiscountRedemption, so there is no second number that can
/// disagree with the first.
model DiscountCode {
  id          String       @id @default(uuid())
  vendorId    String
  vendor      Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  /// Normalised by lib/discounts.ts `normaliseCode` (trimmed, uppercased) on both
  /// the create and the lookup path — the unique index only means anything if both
  /// sides agree on what "the same code" is.
  code        String
  description String?
  kind        DiscountKind
  /// BASIS POINTS for PERCENTAGE (1000 = 10%), PENCE for FIXED_AMOUNT. Integer
  /// arithmetic end to end, for the same reason money is pence.
  value       Int

  /// Judged on the PRE-discount subtotal, matching VendorConfig.minimumOrderPence
  /// and the free-delivery threshold.
  minSubtotalPence     Int       @default(0)
  startsAt             DateTime  @default(now())
  endsAt               DateTime?
  /// null = unlimited. See the counts-down note above.
  remainingRedemptions Int?
  /// null = no per-customer cap, which is also what makes a code guest-usable:
  /// a cap cannot be counted without an identity, and a guest has none.
  maxPerCustomer       Int?
  isActive             Boolean   @default(true)

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  redemptions DiscountRedemption[]

  @@unique([vendorId, code])
  @@index([vendorId, isActive])
}

/// One row per order that used a code. Append-only in normal operation, with a
/// single deliberate exception: `releaseCodeRedemption` DELETES the row when an
/// unpaid order is cancelled (see lib/repositories/discounts.ts for why this is a
/// deletion rather than the reversal row the loyalty ledger writes).
///
/// `seq` is the shopper's zero-based use index for this code, and
/// @@unique([codeId, userId, seq]) is what makes the per-customer cap structural
/// rather than a count-then-write race: two concurrent claims both compute seq 0
/// and the database refuses the second. Guests carry a null userId, and repeated
/// NULLs do not collide in a Postgres unique index — correct, because a code with
/// a per-customer cap refuses guests outright.
///
/// @@unique([orderId]) enforces at most one code per order.
model DiscountRedemption {
  id          String       @id @default(uuid())
  vendorId    String
  vendor      Vendor       @relation(fields: [vendorId], references: [id])
  codeId      String
  code        DiscountCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  seq         Int
  amountPence Int
  createdAt   DateTime     @default(now())

  @@unique([orderId])
  @@unique([codeId, userId, seq])
  @@index([vendorId, codeId])
}

// ---- P6.7 — Team & Role Management (#P6.7) ----------------------------------

/// Audit trail of role assignments within a vendor.
// Guest order lookup rate limiting (P7a fix, #123/#192). #123's proposal asked
// for "rate limiting / lockout... nothing in this codebase does this yet — it
// would be the first" — true, and no Cloudflare KV/rate-limiting binding is
// provisioned (checked wrangler.toml), so this reuses the existing Neon/Prisma
// path rather than inventing new infra for a Fix-stage correction. One row per
// attempt, pruned by age at query time (a count over a 60s window), not on a
// schedule — the table stays small because lookup traffic is inherently low
// volume, and Order-scale retention machinery would be over-building this.
model OrderLookupAttempt {
  id        String   @id @default(uuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  // SHA-256 of the caller's IP, not the IP itself — this table exists purely as
  // a counter, so there is no reason to persist raw IPs at rest.
  ipHash    String
  createdAt DateTime @default(now())

  @@index([vendorId, ipHash, createdAt])
}

model AuthenticationAttempt {
  id        String   @id @default(uuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  // SHA-256 of the caller's IP, not the IP itself — this table exists purely as
  // a counter, so there is no reason to persist raw IPs at rest.
  ipHash    String
  createdAt DateTime @default(now())

  @@index([vendorId, ipHash, createdAt])
}

model VendorRoleAuditLog {
  id        String   @id @default(uuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  userId    String
  user      User     @relation("TargetUser", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("ActorUser", fields: [actorId], references: [id], onDelete: SetNull)
  oldRole   String?
  newRole   String?
  createdAt DateTime @default(now())

  @@index([vendorId, createdAt])
}

// Server-side capture of a thrown request error (#508), independent of Cloudflare Workers
// Logs (#246, unconfirmed queryable) — written from instrumentation.ts's onRequestError, the
// one place that still sees the real error before Next.js reduces it to a generic digest for
// the client boundary (components/errors/ErrorPanel.tsx deliberately renders neither, #430/
// #478/#479). No vendor relation — deliberately platform-wide like HealthCheck, since an error
// boundary can fire before vendor context ever resolves (vendor resolution failing is itself
// one thing that can throw), and resolving one here would risk a second DB read compounding
// whatever already failed.
model ErrorEvent {
  id         String   @id @default(uuid())
  digest     String?
  message    String
  stack      String?
  path       String
  method     String
  routerKind String
  routeType  String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Payment binding refusals (#454, P9.2) — the durable record of every LOUD refusal from
// app/api/webhooks/stripe/route.ts. #429 made that route fail closed, correctly; the cost is
// that a refusal against a GENUINE payment leaves a charged shopper's order stuck
// PENDING_PAYMENT. That route returns 200 and nothing throws, so onRequestError never fires and
// no ErrorEvent row is written — the only other trace is a console.error line whose retention is
// still #246.
//
// vendorId and orderId are NULLABLE by necessity, not by looseness: `not-found` names an order
// that does not exist, and `unbindable` refuses before the lookup happens, so neither can carry
// either. orderNumber is always present — the route returns early on a falsy event.orderNumber
// before any transition is attempted. Refusals resolving to no vendor are recorded for forensics
// and read from the database directly; /staff/payments is a vendor-scoped recovery worklist, and
// by construction a `not-found` refusal strands no order.
//
// The claimed* fields are what the EVENT asserted; the stored* fields are the snapshot of the
// order's own Payment row at refusal time. Keeping both is what lets a reader see the mismatch
// after the fact without re-deriving it. `already-processed` is never recorded: Stripe retries
// aggressively and a duplicate delivery is the system working.
model PaymentBindingRefusal {
  id                       String    @id @default(uuid())
  vendorId                 String?
  vendor                   Vendor?   @relation(fields: [vendorId], references: [id])
  orderId                  String?
  order                    Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNumber              String
  reason                   String
  provider                 String
  claimedProviderReference String?
  claimedAmountPence       Int?
  claimedCurrency          String?
  storedProviderReference  String?
  storedAmountPence        Int?
  storedCurrency           String?
  // Written by the staff reconciliation action (#454): what Stripe said about the order's OWN
  // stored session, never about the session id the refused event claimed.
  resolution               String?
  resolutionDetail         String?
  resolvedAt               DateTime?
  createdAt                DateTime  @default(now())

  @@index([vendorId, createdAt])
  @@index([createdAt])
}

// Search query log (#565, P2.6 slice 2) — every storefront search submission's outcome, so staff
// can find recurring zero-result queries worth promoting into #566's synonym dictionary.
//
// NO USER LINK, deliberately (#570): a search history tied to a signed-in user is personal data,
// which would put it in lib/repositories/data-rights.ts's export/erasure scope. vendorId + a
// hashed IP — never the raw address — is the same shape as OrderLookupAttempt and
// AuthenticationAttempt, which serves the curation purpose (which queries recur) without raising
// the compliance question at all.
//
// directResultCount is the DIRECT (#564) search's own candidate count, captured before any
// zero-result-ladder rung runs. recoveryRung is null when the direct search already succeeded,
// and "typo"/"identity"/"broad"/"none" when the ladder had to run — "none" meaning every rung was
// tried and none found anything, the queries most worth a human look.
model SearchQueryLog {
  id                String   @id @default(uuid())
  vendorId          String
  vendor            Vendor   @relation(fields: [vendorId], references: [id])
  query             String
  directResultCount Int
  recoveryRung      String?
  ipHash            String
  createdAt         DateTime @default(now())

  @@index([vendorId, directResultCount, createdAt])
}
