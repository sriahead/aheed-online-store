// Walking-skeleton schema: ONE model, just enough to prove the end-to-end DB path.
// Real relational model (Users, Products, Orders, …) arrives in P1+ per specs/architecture.md.

generator client {
  provider   = "prisma-client-js"
  // Prisma 6+: driver adapters are GA (no preview flag needed).
  // Prisma 5:  previewFeatures = ["driverAdapters"]
  // engineType = "client" (WASM query compiler, imported directly rather than
  // discovered via fs) is required on Cloudflare Workers — the default
  // "library" engine calls fs.readdir at runtime to locate its native engine
  // binary, which workerd's nodejs_compat polyfill doesn't implement.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (runtime)
  directUrl = env("DIRECT_URL") // direct (migrations)
}

model HealthCheck {
  id        String   @id @default(uuid())
  label     String   @default("ok")
  checkedAt DateTime @default(now())

  @@index([checkedAt])
}

// Better Auth's standard relational schema (ADR-002) — model/field names match its own
// conventions so the Prisma adapter needs no custom mapping config. `role` is our own
// RBAC addition (Customer/Staff/Admin, mission.md); Better Auth passes unknown-to-it
// fields through untouched. No @default(uuid()) on these ids — Better Auth's adapter
// generates and supplies them itself on create.
// Platform-level role (ADR-004 slice 3a). Platform ADMIN is the operator and transcends
// all vendors; most users are CUSTOMER. Per-vendor staff/admin is VendorMembership, not this.
enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

// Per-vendor role (ADR-004 slice 3a). A VendorMembership grants staff/admin at ONE vendor;
// there is no CUSTOMER here (a membership IS a staff/admin grant).
enum VendorRole {
  STAFF
  ADMIN
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  reviews       Review[]
  memberships   VendorMembership[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

// ADR-004 slice 1 — multi-tenancy (specs/2026-08-08-multitenancy-slice1-vendor-schema/).
// Vendor is the tenancy root; every domain row carries a required vendorId. Read-side
// vendorId filtering is enforced centrally in slice 2 (lib/repositories/*). All existing
// data is backfilled to a single "Aheed Food Centre" vendor.
enum VendorStatus {
  ACTIVE
  SUSPENDED
}

model Vendor {
  id            String               @id @default(uuid())
  slug          String               @unique
  name          String
  status        VendorStatus         @default(ACTIVE)
  customDomain  String?              @unique // used in slice 3 (host→tenant resolution)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  branding      VendorBranding?
  config        VendorConfig?
  deliveryAreas VendorDeliveryArea[]
  categories    Category[]
  products      Product[]
  inventory     Inventory[]
  reviews       Review[]
  memberships   VendorMembership[]
  domains       VendorDomain[]
}

// Host→tenant resolution (ADR-004 slice 3b). One row per hostname a vendor answers on
// (exact match); staging and prod are separate DBs, so each holds its own env's hosts.
// Supersedes the unused Vendor.customDomain (kept for now; dropped in a later cleanup).
model VendorDomain {
  id          String   @id @default(uuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  host        String   @unique // exact request host, e.g. "srimart.nocaped.com"
  isCanonical Boolean  @default(true) // the vendor's primary host (for links / future redirects)
  createdAt   DateTime @default(now())

  @@index([vendorId])
}

// Per-vendor staff/admin grant (ADR-004 slice 3a). Identity stays global (User); this
// scopes authorization to a single vendor. One row per (user, vendor).
model VendorMembership {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  role      VendorRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, vendorId])
  @@index([vendorId])
}

// Satellite config/branding tables ship EMPTY in slice 1 — their values (and the code that
// reads them) arrive in slice 4. Explicit columns only, never a Json column (CLAUDE.md).
model VendorBranding {
  id             String   @id @default(uuid())
  vendorId       String   @unique
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name           String
  tagline        String?
  logoStorageKey String? // RELATIVE key only (ADR-003) — never a URL
  // Brand color PRIMITIVES (mirror design-system/tokens/tokens.css --color-brand-*),
  // injected per vendor as CSS custom properties in slice 4. Hex strings.
  brandGreenDark  String
  brandGreen      String
  brandOrange     String
  brandRed        String
  brandCream      String
  brandGreenTint  String
  brandOrangeTint String
  brandRedTint    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model VendorConfig {
  id           String   @id @default(uuid())
  vendorId     String   @unique
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  localityName String // e.g. "Milton Keynes"
  senderName   String // transactional email sender identity
  senderEmail  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VendorDeliveryArea {
  id       String @id @default(uuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  prefix   String // postcode district prefix, e.g. "MK"

  @@unique([vendorId, prefix])
}

// P2a — catalogue browsing (specs/2026-08-07-p2a-catalogue-browsing/). Matches the
// representative schema already designed in specs/architecture.md §3.2.
model Category {
  id        String     @id @default(uuid())
  vendorId  String
  vendor    Vendor     @relation(fields: [vendorId], references: [id])
  slug      String
  name      String
  parentId  String?
  parent    Category?  @relation("Sub", fields: [parentId], references: [id])
  children  Category[] @relation("Sub")
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  products  Product[]

  @@unique([vendorId, slug])
  @@index([vendorId, parentId, isActive])
}

model Product {
  id            String         @id @default(uuid())
  vendorId      String
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  slug          String
  name          String
  description   String
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  basePrice     Int // pence
  unitLabel     String // "£2.40 / kg"
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  images        ProductImage[]
  inventory     Inventory?
  reviews       Review[]
  averageRating Float          @default(0) // denormalized, recomputed on every review write
  reviewCount   Int            @default(0)
  // P2.5b1 — visual redesign foundation (specs/2026-08-07-p2-5b1-visual-foundation/).
  // originalPrice, when set, is basePrice's pre-discount price — a discount badge is
  // derived from the difference at render time, not a separate boolean flag that could
  // drift out of sync with the actual prices.
  origin        String?
  originalPrice Int? // pence, pre-discount price
  isHalal       Boolean        @default(false)
  isFresh       Boolean        @default(false)
  isOrganic     Boolean        @default(false)

  @@unique([vendorId, slug])
  @@index([vendorId, categoryId, isActive])
  @@index([vendorId, isActive, basePrice]) // catalogue filter + sort
}

model ProductImage {
  id         String  @id @default(uuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  storageKey String // RELATIVE key only — never a URL
  alt        String
  sortOrder  Int     @default(0)
  isPrimary  Boolean @default(false)

  @@index([productId, sortOrder])
}

model Inventory {
  id                String   @id @default(uuid())
  vendorId          String
  vendor            Vendor   @relation(fields: [vendorId], references: [id])
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id])
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(3)
  updatedAt         DateTime @updatedAt

  @@index([vendorId])
}

// P2.5a — ratings & reviews (specs/2026-08-07-p2-5a-ratings-reviews/). One review
// per user per product; resubmitting updates the existing row. Product's
// averageRating/reviewCount are denormalized and recomputed on every write.
model Review {
  id        String   @id @default(uuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorId, userId, productId])
  @@index([vendorId, productId, createdAt])
}
