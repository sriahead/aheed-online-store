// Walking-skeleton schema: ONE model, just enough to prove the end-to-end DB path.
// Real relational model (Users, Products, Orders, …) arrives in P1+ per specs/architecture.md.

generator client {
  provider   = "prisma-client-js"
  // Prisma 6+: driver adapters are GA (no preview flag needed).
  // Prisma 5:  previewFeatures = ["driverAdapters"]
  // engineType = "client" (WASM query compiler, imported directly rather than
  // discovered via fs) is required on Cloudflare Workers — the default
  // "library" engine calls fs.readdir at runtime to locate its native engine
  // binary, which workerd's nodejs_compat polyfill doesn't implement.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (runtime)
  directUrl = env("DIRECT_URL") // direct (migrations)
}

model HealthCheck {
  id        String   @id @default(uuid())
  label     String   @default("ok")
  checkedAt DateTime @default(now())

  @@index([checkedAt])
}

// Better Auth's standard relational schema (ADR-002) — model/field names match its own
// conventions so the Prisma adapter needs no custom mapping config. `role` is our own
// RBAC addition (Customer/Staff/Admin, mission.md); Better Auth passes unknown-to-it
// fields through untouched. No @default(uuid()) on these ids — Better Auth's adapter
// generates and supplies them itself on create.
// Platform-level role (ADR-004 slice 3a). Platform ADMIN is the operator and transcends
// all vendors; most users are CUSTOMER. Per-vendor staff/admin is VendorMembership, not this.
enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

// Per-vendor role (ADR-004 slice 3a). A VendorMembership grants staff/admin at ONE vendor;
// there is no CUSTOMER here (a membership IS a staff/admin grant).
enum VendorRole {
  STAFF
  ADMIN
}

model User {
  id              String               @id
  name            String
  email           String               @unique
  emailVerified   Boolean              @default(false)
  image           String?
  role            Role                 @default(CUSTOMER)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  sessions        Session[]
  accounts        Account[]
  reviews         Review[]
  memberships     VendorMembership[]
  carts           Cart[]
  addresses       Address[]
  orders          Order[]
  statusChanges   OrderStatusEvent[]   @relation("OrderStatusEventActor")
  loyaltyAccounts LoyaltyAccount[]
  loyaltyEntries  LoyaltyLedgerEntry[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

// ADR-004 slice 1 — multi-tenancy (specs/2026-08-08-multitenancy-slice1-vendor-schema/).
// Vendor is the tenancy root; every domain row carries a required vendorId. Read-side
// vendorId filtering is enforced centrally in slice 2 (lib/repositories/*). All existing
// data is backfilled to a single "Aheed Food Centre" vendor.
enum VendorStatus {
  ACTIVE
  SUSPENDED
}

model Vendor {
  id              String               @id @default(uuid())
  slug            String               @unique
  name            String
  status          VendorStatus         @default(ACTIVE)
  customDomain    String?              @unique // used in slice 3 (host→tenant resolution)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  branding        VendorBranding?
  config          VendorConfig?
  deliveryAreas   VendorDeliveryArea[]
  categories      Category[]
  products        Product[]
  inventory       Inventory[]
  reviews         Review[]
  memberships     VendorMembership[]
  domains         VendorDomain[]
  carts           Cart[]
  cartItems       CartItem[]
  addresses       Address[]
  orders          Order[]
  orderItems      OrderItem[]
  payments        Payment[]
  orderEvents     OrderStatusEvent[]
  loyaltyTiers    VendorLoyaltyTier[]
  loyaltyAccounts LoyaltyAccount[]
  loyaltyEntries  LoyaltyLedgerEntry[]
}

// Host→tenant resolution (ADR-004 slice 3b). One row per hostname a vendor answers on
// (exact match); staging and prod are separate DBs, so each holds its own env's hosts.
// Supersedes the unused Vendor.customDomain (kept for now; dropped in a later cleanup).
model VendorDomain {
  id          String   @id @default(uuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  host        String   @unique // exact request host, e.g. "srimart.nocaped.com"
  isCanonical Boolean  @default(true) // the vendor's primary host (for links / future redirects)
  createdAt   DateTime @default(now())

  @@index([vendorId])
}

// Per-vendor staff/admin grant (ADR-004 slice 3a). Identity stays global (User); this
// scopes authorization to a single vendor. One row per (user, vendor).
model VendorMembership {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  role      VendorRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, vendorId])
  @@index([vendorId])
}

// Satellite config/branding tables ship EMPTY in slice 1 — their values (and the code that
// reads them) arrive in slice 4. Explicit columns only, never a Json column (CLAUDE.md).
model VendorBranding {
  id              String   @id @default(uuid())
  vendorId        String   @unique
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name            String
  tagline         String?
  logoStorageKey  String? // RELATIVE key only (ADR-003) — never a URL
  // Brand color PRIMITIVES (mirror design-system/tokens/tokens.css --color-brand-*),
  // injected per vendor as CSS custom properties in slice 4. Hex strings.
  brandGreenDark  String
  brandGreen      String
  brandOrange     String
  brandRed        String
  brandCream      String
  brandGreenTint  String
  brandOrangeTint String
  brandRedTint    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model VendorConfig {
  id                         String   @id @default(uuid())
  vendorId                   String   @unique
  vendor                     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  localityName               String // e.g. "Milton Keynes"
  senderName                 String // transactional email sender identity
  senderEmail                String
  searchPlaceholder          String? // header search-box copy, e.g. "Search halal lamb, basmati, lentils…"
  // P3a — delivery rules are vendor data, never constants (the AI Studio mockup hardcoded a
  // £30 threshold). Prisma-level defaults mean a newly-inserted vendor is valid without the
  // seed supplying values. P3a reads only the threshold (cart banner); applying the fee and
  // the minimum to a payable total is P3b.
  deliveryFeePence           Int      @default(349)
  freeDeliveryThresholdPence Int? // null = free delivery never offered
  minimumOrderPence          Int      @default(0) // 0 = no minimum
  // P5a — loyalty settings are vendor data for the same reason the delivery rules
  // above are (#135). Defaults mean an existing VendorConfig row stays valid with
  // no backfill, and loyaltyEnabled defaults OFF so the feature ships dark for any
  // vendor that hasn't opted in.
  loyaltyEnabled             Boolean  @default(false)
  pointsPerPoundEarned       Int      @default(1) // points per whole £1 of eligible spend
  pencePerPointRedeemed      Int      @default(1) // 100 points = £1
  minRedeemPoints            Int      @default(100) // below this, redemption isn't offered
  tierWindowDays             Int      @default(30) // rolling window tier qualification looks back over
  pointsExpiryMonths         Int? // null = points never expire
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

// P5a — per-vendor loyalty tiers (#135). A shopper's tier is resolved from their
// qualifying spend over VendorConfig.tierWindowDays; the highest threshold at or
// below that spend wins. Multipliers are BASIS POINTS (10000 = 1.0x) — integer
// arithmetic end to end, for the same reason money is pence.
model VendorLoyaltyTier {
  id             String   @id @default(uuid())
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  key            String // stable identifier, e.g. "SILVER"
  name           String // display name
  thresholdPence Int // qualifying spend at or above which this tier applies
  multiplierBps  Int      @default(10000)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([vendorId, key])
  @@index([vendorId, thresholdPence])
}

model VendorDeliveryArea {
  id       String @id @default(uuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  prefix   String // postcode district prefix, e.g. "MK"

  @@unique([vendorId, prefix])
}

// P2a — catalogue browsing (specs/2026-08-07-p2a-catalogue-browsing/). Matches the
// representative schema already designed in specs/architecture.md §3.2.
model Category {
  id        String     @id @default(uuid())
  vendorId  String
  vendor    Vendor     @relation(fields: [vendorId], references: [id])
  slug      String
  name      String
  parentId  String?
  parent    Category?  @relation("Sub", fields: [parentId], references: [id])
  children  Category[] @relation("Sub")
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  products  Product[]

  @@unique([vendorId, slug])
  @@index([vendorId, parentId, isActive])
}

model Product {
  id            String         @id @default(uuid())
  vendorId      String
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  slug          String
  name          String
  description   String
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  basePrice     Int // pence
  unitLabel     String // "£2.40 / kg"
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  images        ProductImage[]
  inventory     Inventory?
  reviews       Review[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  averageRating Float          @default(0) // denormalized, recomputed on every review write
  reviewCount   Int            @default(0)
  // P2.5b1 — visual redesign foundation (specs/2026-08-07-p2-5b1-visual-foundation/).
  // originalPrice, when set, is basePrice's pre-discount price — a discount badge is
  // derived from the difference at render time, not a separate boolean flag that could
  // drift out of sync with the actual prices.
  origin        String?
  originalPrice Int? // pence, pre-discount price
  isHalal       Boolean        @default(false)
  isFresh       Boolean        @default(false)
  isOrganic     Boolean        @default(false)

  @@unique([vendorId, slug])
  @@index([vendorId, categoryId, isActive])
  @@index([vendorId, isActive, basePrice]) // catalogue filter + sort
}

model ProductImage {
  id         String  @id @default(uuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  storageKey String // RELATIVE key only — never a URL
  alt        String
  sortOrder  Int     @default(0)
  isPrimary  Boolean @default(false)

  @@index([productId, sortOrder])
}

model Inventory {
  id                String   @id @default(uuid())
  vendorId          String
  vendor            Vendor   @relation(fields: [vendorId], references: [id])
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id])
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(3)
  updatedAt         DateTime @updatedAt

  @@index([vendorId])
}

// P2.5a — ratings & reviews (specs/2026-08-07-p2-5a-ratings-reviews/). One review
// per user per product; resubmitting updates the existing row. Product's
// averageRating/reviewCount are denormalized and recomputed on every write.
model Review {
  id        String   @id @default(uuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorId, userId, productId])
  @@index([vendorId, productId, createdAt])
}

// P3a — cart foundation (specs/2026-08-09-p3a-cart-foundation/, #93).
// One cart per (vendor, identity): shopping at two vendors gives two independent
// carts, which falls straight out of ADR-004 row-level tenancy.
// Identity is EXACTLY ONE of userId / guestToken — a guest cart is keyed by an
// opaque token in a host-only cookie, and is merged into the account cart only
// when the shopper explicitly chooses (never silently).
model Cart {
  id         String     @id @default(uuid())
  vendorId   String
  vendor     Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]

  @@unique([vendorId, userId])
  @@unique([vendorId, guestToken])
  @@index([vendorId])
}

// Deliberately stores NO price. Price is read from Product at render time and is
// snapshotted into OrderItem at order creation (P3b) — a cart that cached prices
// would silently serve stale money after a price change.
model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
}

// P3b — checkout + order core (specs/2026-08-10-p3b-checkout-order-core/, #96).
// PENDING_PAYMENT is the initial state: stock is decremented at order creation but
// payment is not yet settled, so an order must NOT read as CONFIRMED (staff would
// pick and deliver it). P3c's Stripe webhook moves it to CONFIRMED.
enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// Per-order delivery address SNAPSHOT. Written once and never updated — editing a
// saved address later must not rewrite where a past order was delivered
// (architecture.md §3.1: "historical snapshots are intentional"). userId is
// nullable so a future saved-address book can reuse this table with no migration.
model Address {
  id            String   @id @default(uuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  recipientName String
  phone         String
  line1         String
  line2         String?
  city          String
  postcode      String
  notes         String?
  createdAt     DateTime @default(now())
  orders        Order[]

  @@index([vendorId])
}

// Exactly one of userId / guestEmail identifies the buyer (enforced in the
// repository). Money is integer pence throughout; no discountTotal/loyaltyRedeemed
// columns — those are P5's to add when they exist.
model Order {
  id               String               @id @default(uuid())
  vendorId         String
  vendor           Vendor               @relation(fields: [vendorId], references: [id])
  orderNumber      String               @unique
  userId           String?
  user             User?                @relation(fields: [userId], references: [id])
  guestEmail       String?
  addressId        String
  address          Address              @relation(fields: [addressId], references: [id])
  status           OrderStatus          @default(PENDING_PAYMENT)
  currency         String               @default("GBP")
  subtotalPence    Int
  // P5a (#135) — a GENERIC discount column, not a points-specific one: P5b's
  // discount codes reduce the same total and must not need a second column and a
  // second arithmetic rule. The order money identity is
  // subtotalPence - discountPence + deliveryFeePence = totalPence.
  discountPence    Int                  @default(0)
  deliveryFeePence Int
  totalPence       Int
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  items            OrderItem[]
  payment          Payment?
  statusEvents     OrderStatusEvent[]
  loyaltyEntries   LoyaltyLedgerEntry[]

  @@index([vendorId, createdAt])
  @@index([vendorId, status, createdAt])
}

// productName / unitPricePence are SNAPSHOTS at purchase time — a later price or
// rename must never rewrite what the customer actually bought.
model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor  @relation(fields: [vendorId], references: [id])
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  productName    String
  unitPricePence Int
  quantity       Int
  lineTotalPence Int

  @@index([orderId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            Vendor        @relation(fields: [vendorId], references: [id])
  status            PaymentStatus @default(PENDING)
  provider          String
  providerReference String?
  amountPence       Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
}

model OrderStatusEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor      @relation(fields: [vendorId], references: [id])
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  // Who moved it (P4b, #125). Null for system transitions — P3b's order
  // placement and P3c's payment webhook have no acting user, and nullable is
  // what lets this column be added with no backfill. SetNull, not Cascade:
  // removing a departed staff member's account must not delete the audit trail
  // of the orders they handled.
  createdByUserId String?
  createdBy       User?   @relation("OrderStatusEventActor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ---- P5a — loyalty points (#135, specs/2026-08-11-p5a-loyalty-points/) --------

enum LoyaltyEntryKind {
  EARN
  REDEEM
  REVERSAL
}

/// The append-only audit trail of every points movement. `points` is SIGNED:
/// EARN is positive, REDEEM negative, REVERSAL the exact negation of the REDEEM
/// it undoes. Nothing here is ever updated or deleted.
///
/// @@unique([orderId, kind]) is the structural idempotency guard: a duplicate
/// Stripe delivery attempting a second EARN, or a double-submitted checkout
/// attempting a second REDEEM, is refused by the database rather than by a check
/// someone has to remember to write.
model LoyaltyLedgerEntry {
  id       String           @id @default(uuid())
  vendorId String
  vendor   Vendor           @relation(fields: [vendorId], references: [id])
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId  String
  order    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind     LoyaltyEntryKind
  points   Int // signed

  // Snapshotted on EARN only. Tier is resolved from a windowed spend query whose
  // answer changes over time, so an audit trail that cannot explain its own
  // numbers would not be one. Null on REDEEM/REVERSAL.
  tierKey       String?
  multiplierBps Int?

  createdAt DateTime @default(now())

  @@unique([orderId, kind])
  @@index([vendorId, userId, createdAt])
}

/// The concurrency anchor for a shopper's balance at one vendor.
///
/// NOT a redundant cache of the ledger: a balance derived by SUM() cannot be
/// compare-and-set, and every other contended resource in this schema is
/// protected that way. This is the same pairing the stock path already uses —
/// Inventory.quantity is the guarded counter, OrderItem is the record of what
/// moved.
///
/// `lastActivityAt` is what makes expiry derivable at read time instead of
/// needing a sweep job: points lapse when it falls further behind than
/// VendorConfig.pointsExpiryMonths. A lapsed row's balancePoints is stale until
/// its next EARN, which RESETS rather than increments (see lib/loyalty.ts).
model LoyaltyAccount {
  id             String   @id @default(uuid())
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balancePoints  Int      @default(0)
  lifetimePoints Int      @default(0)
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([vendorId, userId])
}
