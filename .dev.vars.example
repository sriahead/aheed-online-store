# Cloudflare local-dev bindings (wrangler / OpenNext reads .dev.vars).
# Copy to .dev.vars for `npm run preview`. NEVER commit real values.
# DATABASE_URL should point at YOUR personal Neon dev branch, not staging — see
# docs/env-setup.md's "Local development (dev)" section for how to create one and find
# its connection strings.
DATABASE_URL="postgres://...-pooler.../db?sslmode=require"
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_BUCKET="aheed-images-dev"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"
CDN_BASE_URL="https://images.aheedfoodcentre.nocaped.com"
BETTER_AUTH_SECRET="generate locally: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:8787"
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
