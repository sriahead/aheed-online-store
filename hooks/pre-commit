#!/usr/bin/env bash
# SDD Gate 2 — spec-before-code.
# Blocks a commit that touches source dirs unless a specs/*/requirements.md is new on this branch.
#
# THIS HOOK IS THE ONLY ENFORCEMENT OF GATE 2. The header here used to read "local fast feedback;
# gates.yml is the real enforcement", which was false and had been for a long time: no workflow in
# .github/workflows/ references requirements.md at all (verified 2026-10-05, #994). So a bypass
# here is a bypass of the gate, not of a local convenience — which is why the exemption below is a
# list of exact generated paths rather than a pattern.
set -euo pipefail

SOURCE_DIRS='^(app|components|features|lib|prisma|kms|design-system)/'

# #994 — machine-written artefacts are not hand-authored source, so they do not demand a spec.
#
# `app/(admin)/staff/runbook/docs.ts` is generated by `npm run kms:build-index` and matches
# SOURCE_DIRS. CI's `npm run kms:check-generated` REQUIRES it committed and current, so a
# documentation-only branch that bumps any front-matter version had no legal move: commit the
# regenerated artefact and this hook refused it, leave it out and CI went red.
#
# It only began to bite once a Document pass recorded a PROMOTION. The spec test below asks
# whether a `specs/*/requirements.md` is NEW relative to origin/main; every earlier docs branch was
# cut from a staging whose slice spec had not yet been promoted, so the slice's own requirements
# still read as new and this hook passed by accident. A promotion is what puts that spec on main.
#
# Narrow on purpose: it exempts THESE PATHS, not a pattern like "any .ts under app". A commit
# staging a hand-authored file alongside them is still judged on that file, so the exemption
# cannot become a hole in Gate 2 — the spec's R33 exists to prove that direction specifically.
GENERATED_PATHS='^app/\(admin\)/staff/runbook/docs\.ts$'

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

touches_source=$(echo "$staged" | grep -E "$SOURCE_DIRS" | grep -vE "$GENERATED_PATHS" || true)
[ -z "$touches_source" ] && exit 0

base=$(git merge-base HEAD origin/main 2>/dev/null || echo "")
if [ -z "$base" ]; then
  # No origin/main reachable (e.g. offline, or this IS main) — can't compare, don't block.
  exit 0
fi

new_specs=$(git diff --name-only --diff-filter=A "$base"...HEAD -- 'specs/*/requirements.md' 2>/dev/null || true)
staged_specs=$(echo "$staged" | grep -E '^specs/.*/requirements\.md$' || true)

if [ -z "$new_specs" ] && [ -z "$staged_specs" ]; then
  echo "Gate 2 failed — source changes staged, but no specs/<date-feature>/requirements.md" >&2
  echo "found on this branch (compared to origin/main). Add a spec first, or:" >&2
  echo "  git commit --no-verify   (only if you know this is exempt)" >&2
  exit 1
fi

exit 0
