node_modules/
.next/
.open-next/
.wrangler/
out/
build/

# env & secrets — never commit
.env
.env.*
!.env.example
.dev.vars
!.dev.vars.example

# per-environment secret inputs for scripts/configure-env.mjs — never commit
secrets/*.vars
!secrets/example.vars

# prisma generated client (regenerated in CI)
# (keep migrations tracked)
*.log
.DS_Store

# TypeScript incremental build cache — local/machine-specific
tsconfig.tsbuildinfo

# KMS — assembled site content is a build artifact (kms/scripts/assemble.ts),
# never hand-edited; single source of truth stays in specs/, docs/, CLAUDE.md.
# assemble.ts writes generated docs directly into content/<track>/*.mdx, alongside
# hand-authored index.mdx/_meta.json (never touched by the script) — so ignore all
# .mdx one level under content/ except index.mdx, rather than a _generated/ subdir
# the script doesn't actually use.
kms/site-*/content/*/*.mdx
!kms/site-*/content/*/index.mdx
kms/site-*/.next-env.d.ts

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Per-developer Claude config: machine-specific paths, personal hooks and MCP
# enablement. It must stay local for every contributor, so ignore it here rather
# than relying on an individual's global gitignore.
.claude/settings.local.json
