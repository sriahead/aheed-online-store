node_modules/
.next/
.open-next/
.wrangler/
out/
build/

# env & secrets — never commit
.env
.env.*
!.env.example
.dev.vars
!.dev.vars.example

# per-environment secret inputs for scripts/configure-env.mjs — never commit
secrets/*.vars
!secrets/example.vars

# prisma generated client (regenerated in CI)
# (keep migrations tracked)
*.log
.DS_Store

# TypeScript incremental build cache — local/machine-specific
tsconfig.tsbuildinfo

# KMS — assembled site content is a build artifact (kms/scripts/assemble.ts),
# never hand-edited; single source of truth stays in specs/, docs/, CLAUDE.md.
# assemble.ts writes generated docs to content/<track>/<type>/<id>.mdx, alongside
# hand-authored index.mdx pages the script never touches — so ignore every .mdx at
# ANY depth under content/, except index.mdx at any depth.
#
# Depth-agnostic on purpose (#857): the previous rule matched exactly one level
# (content/*/*.mdx), which was correct until #853 moved generated content a level
# deeper. It then silently stopped matching anything assemble.ts writes, leaving
# ~194 generated files untracked in every working copy while CI stayed green,
# because CI assembles into a throwaway checkout and never commits.
kms/site-*/content/**/*.mdx
!kms/site-*/content/**/index.mdx
kms/site-*/.next-env.d.ts

# KMS — Pagefind search index, generated by kms/site-internal's postbuild step
# (#871). ~244 files, ~3.3 MB, rebuilt from the prerendered HTML on every build
# and copied into the Worker's assets by opennextjs-cloudflare. Never committed.
kms/site-*/public/_pagefind/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Per-developer Claude config: machine-specific paths, personal hooks and MCP
# enablement. It must stay local for every contributor, so ignore it here rather
# than relying on an individual's global gitignore.
.claude/settings.local.json

# Local scratch area for brand artwork and generated asset pages (added #1077,
# 2026-10-13). Held per-developer on purpose: the real logo/mark artwork is an
# OWNER deliverable that enters the product by upload on /staff/storefront, which
# writes a relative storage key to VendorBranding (ADR-003) — never a file in the
# repo. Nothing brand-specific may live in public/ or app/ either, since those are
# shared by every vendor (ADR-004). A committed copy here would be a second,
# unversioned source of truth for an asset the database already owns.
/misc/
