# Template for scripts/configure-env.mjs — copy to secrets/<env>.vars and fill in.
#   cp secrets/example.vars secrets/staging.vars      (then edit)
#   cp secrets/example.vars secrets/production.vars    (then edit)
# #1323 — the Merqify move uses NEW files beside the old ones, so the old ones stay as rollback:
#   cp secrets/example.vars secrets/merqify-staging.vars
#   cp secrets/example.vars secrets/merqify-production.vars
#   npm run configure-env -- staging --file secrets/merqify-staging.vars
# secrets/*.vars are gitignored (except this file). NEVER commit real values.
# Format: KEY=value (quotes optional). Blank lines and # comments are ignored.

# --- GitHub environment secrets (used by CI deploy workflows) --------------
# The Merqify account's id, and a token scoped to THAT ACCOUNT ONLY (never a login-wide token).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Neon DIRECT (unpooled) URL — migrations only, never read at runtime.
DIRECT_URL=

# --- Cloudflare Worker runtime secrets (used by the app at runtime) --------
# Neon POOLED URL (the host with -pooler).
DATABASE_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# A fresh random value per environment (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# Per-environment: https://aheed-staging.merqify.com  or  https://aheed.merqify.com
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
# From the webhook endpoint registered for this environment's host in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=
# R2 S3 API: endpoint https://<account-id>.r2.cloudflarestorage.com, region "auto".
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
# Per-environment: https://images-staging.merqify.com  or  https://images.merqify.com
CDN_BASE_URL=
