{
  "name": "aheed-online-store",
  "version": "0.0.0",
  "private": true,
  "description": "Aheed Food Centre — walking skeleton (end-to-end smoke test on Cloudflare Workers + Neon).",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "demo:accounts": "tsx scripts/demo-accounts.ts",
    "configure-env": "node scripts/configure-env.mjs",
    "sdd:preclear": "tsx scripts/sdd-check.ts preclear",
    "sdd:audit": "tsx scripts/sdd-check.ts audit",
    "kms:validate": "tsx kms/schema/validate.ts",
    "kms:build-index": "tsx kms/scripts/build-index.ts",
    "kms:assemble:internal": "tsx kms/scripts/assemble.ts --visibility internal",
    "kms:assemble:public": "tsx kms/scripts/assemble.ts --visibility public",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^6.19.3",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.26",
    "lucide-react": "^1.30.0",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.4.5",
    "esbuild": "0.28.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "puppeteer": "^25.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.86.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "workerd@1.20260801.1": true,
    "sharp@0.35.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "dotenv@16.6.1": true
  }
}
