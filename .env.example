# ---- Local development (.env) — copy to .env and fill. NEVER commit real values ----
# DATABASE_URL/DIRECT_URL below should point at YOUR personal Neon dev branch, not staging —
# see docs/env-setup.md's "Local development (dev)" section for how to create one and find
# its connection strings.

# Neon Postgres (your personal dev branch — see note above)
DATABASE_URL=            # POOLED url (host contains -pooler). Runtime.
DIRECT_URL=              # DIRECT url (no -pooler). Migrations/seed only.

# Object storage — S3-compatible API only (R2 now; S3/GCS later)
S3_ENDPOINT=             # https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=               # aheed-images-dev (shared dev bucket — see docs/developer-portal/env-setup.md)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# Bucket and CDN host are STRICTLY PAIRED — see the table in docs/developer-portal/env-setup.md.
# Local dev uses the dev host, the only one with NO hotlink rule, which is what lets images load
# under `npm run preview` (referer http://localhost:3000). Staging/production hosts return 403 there.
#   local dev  -> https://images.dev.aheedfoodcentre.nocaped.com      (bucket aheed-images-dev)
#   staging    -> https://images.staging.aheedfoodcentre.nocaped.com  (bucket aheed-images-staging)
#   production -> https://images.aheedfoodcentre.nocaped.com          (bucket aheed-images-production)
CDN_BASE_URL=            # https://images.dev.aheedfoodcentre.nocaped.com  (relative keys appended at runtime)

# Auth (ADR-002 — Better Auth)
BETTER_AUTH_SECRET=      # generate locally: openssl rand -base64 32 (not a third-party credential)
BETTER_AUTH_URL=         # http://localhost:3000 locally; per-environment domain in staging/prod

# Google Sign-In (P1b, issue #28). Optional: unset = email/password-only,
# "Continue with Google" doesn't render.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (lib/email — Resend adapter). Optional: unset = sending
# degrades (logged, doesn't crash the request) until a real key is provisioned.
RESEND_API_KEY=
RESEND_FROM_EMAIL=       # e.g. no-reply@aheedfoodcentre.nocaped.com
